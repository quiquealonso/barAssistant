@startuml diagramasecuencia
title Select a Table
autonumber
actor Usuari as U 
box "system"
    participant B as "<<boundary>>\nSelectTableComponent"
    participant C as "<<control>>\nTableService"
    participant E as "<<entity>>\nTableRepository"
end box
B->C: getTables()
C->E: findAll()
E-->C: tablesList
C-->B: tablesList
U->B: select on a table
U->B: select on a table


@enduml
